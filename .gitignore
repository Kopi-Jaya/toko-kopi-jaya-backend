# Dependencies
node_modules/

# Build output
dist/
coverage/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Sensitive credentials doc
CREDENTIALS.md

# Ad-hoc migration/inspection scripts — these hardcode SSH and DB
# credentials, and this repo is public. Keep them local-only.
sql/*.py
sql/run_migration.cjs

# Claude context
.claude/

# Logs
npm-debug.log*
yarn-debug.log*

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Prisma generated client (regenerated on install)
node_modules/.prisma/
